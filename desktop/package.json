{
  "name": "heavent-admin",
  "productName": "Heavent Admin",
  "version": "1.0.0",
  "description": "Application Mac de l'administration Heavent People Agency",
  "author": "Heavent People Agency",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.heaventagency.admin",
    "productName": "Heavent Admin",
    "copyright": "© Heavent People Agency",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "build/icon.png"],
    "afterPack": "./signer-adhoc.js",
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "dmg": {
      "title": "Heavent Admin",
      "artifactName": "Heavent-Admin-${version}-${arch}.${ext}",
      "contents": [
        { "x": 140, "y": 190, "type": "file" },
        { "x": 400, "y": 190, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    }
  }
}
