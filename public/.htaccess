# Heavent People Agency — configuration du serveur (one.com / Apache)
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.heaventagency.com → heaventagency.com (une seule adresse pour Google)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # NB : pas de redirection /page/ → /page. Les anciennes adresses redirigeaient /page → /page/ (redirection
  # mémorisée par les navigateurs) : rediriger dans l'autre sens créerait une boucle. Les deux formes affichent
  # la même page, et la balise « canonical » indique à Google la bonne adresse.

  # /page → page pré-générée /page/index.html (contenu lisible directement par Google)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Adresses dynamiques de l'application (jeton dans l'adresse) et /realisations : l'application se charge de les afficher
  # Invitations : même application, avec un aperçu de lien qui explique ce que c'est (WhatsApp, SMS)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^invitation/. invitation-modele.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^rsvp/. rsvp-modele.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^reponse/. rsvp-modele.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(mon-devis|mon-mariage|rsvp|invitation|desinscription|studio/demo|prestataires/confirmer|realisations|bureau)(/|$)
  RewriteRule ^ index.html [L]

  # Toute autre adresse inexistante : vraie erreur 404 (page d'erreur de l'application, non indexée), plutôt que l'accueil en « 200 »
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Fichiers de /assets : leur nom change à chaque mise à jour → cache d'un an
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images, polices, vidéos : cache de 30 jours (une photo remplacée sous le même nom met jusqu'à 30 jours
  # à se mettre à jour chez un visiteur qui l'a déjà vue → pour un changement immédiat, changer le nom du fichier)
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2?|ttf|otf|mp4|webm|mp3)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Appli admin : le service worker et le manifeste doivent toujours être frais
  <FilesMatch "^(admin-sw\.js|admin\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Sécurité : le site ne peut pas être affiché dans un cadre d'un autre site (anti-hameçonnage par superposition),
  # connexion toujours chiffrée, et pas d'accès au micro / à la position par défaut
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
  # Politique de sécurité des contenus, en OBSERVATION (rien n'est bloqué : le navigateur signale seulement dans sa console).
  # Les deux empreintes sha256 sont celles des 2 scripts écrits dans index.html : à recalculer si ces scripts changent (voir DEPLOIEMENT.md).
  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-Q74BmTtyeOM6P7kz9L++H9hGBxGeJDmdVLQDFB8EzO0=' 'sha256-gwFxyw7WZb5IZ6Y4e4TYcJDzb8DAdnSHC1uw3ibCI7E=' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://www.google.com https://www.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net; media-src 'self' blob: data: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.g.doubleclick.net https://www.google.com; worker-src 'self' blob:; frame-src 'self' https://td.doubleclick.net https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
