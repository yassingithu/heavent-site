# Heavent People Agency — configuration du serveur (one.com / Apache)
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.heaventagency.com → heaventagency.com (une seule adresse pour Google)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # NB : pas de redirection /page/ → /page. Les anciennes adresses redirigeaient /page → /page/ (redirection
  # mémorisée par les navigateurs) : rediriger dans l'autre sens créerait une boucle. Les deux formes affichent
  # la même page, et la balise « canonical » indique à Google la bonne adresse.

  # /page → page pré-générée /page/index.html (contenu lisible directement par Google)
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  # Toute autre adresse : l'application
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # Fichiers de /assets : leur nom change à chaque mise à jour → cache d'un an
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Appli admin : le service worker et le manifeste doivent toujours être frais
  <FilesMatch "^(admin-sw\.js|admin\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Sécurité : le site ne peut pas être affiché dans un cadre d'un autre site (anti-hameçonnage par superposition),
  # connexion toujours chiffrée, et pas d'accès au micro / à la position par défaut
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
</IfModule>
